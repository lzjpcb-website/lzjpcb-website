<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LZJPCB | PCB & PCBA Manufacturing</title>
  <meta name="description" content="LZJPCB provides one-stop PCB and PCBA manufacturing services from prototype to production.">
  <meta name="robots" content="index,follow">
  <link rel="canonical" href="https://szpcbpcba.com/">
  <link rel="alternate" hreflang="x-default" href="https://szpcbpcba.com/en/index.html">
  <link rel="alternate" hreflang="en" href="https://szpcbpcba.com/en/index.html">
  <link rel="alternate" hreflang="zh-CN" href="https://szpcbpcba.com/zh/index.html">
  <link rel="alternate" hreflang="pt-BR" href="https://szpcbpcba.com/pt/index.html">
  <link rel="alternate" hreflang="fr-FR" href="https://szpcbpcba.com/fr/index.html">
  <link rel="alternate" hreflang="es-ES" href="https://szpcbpcba.com/es/index.html">
  <style>
    /* 根目录语言入口：不依赖外部 CSS，避免部署初期路径问题 */
    *{box-sizing:border-box}
    body{margin:0;min-height:100vh;background:#071A2D;color:#fff;font-family:Inter,Arial,Helvetica,sans-serif;display:flex;align-items:center;justify-content:center}
    .wrap{width:min(920px,92%);text-align:center;padding:56px 20px}
    .logo{font-size:42px;font-weight:900;letter-spacing:-1.8px;color:#62B4F2}
    .eyebrow{margin-top:12px;font-size:12px;font-weight:800;letter-spacing:.16em;color:#A8C8E3}
    h1{font-size:clamp(30px,5vw,48px);line-height:1.12;margin:18px 0 12px}
    .sub{max-width:650px;margin:0 auto 34px;color:#D6E3EE;font-size:16px;line-height:1.7}
    .languages{display:flex;flex-wrap:wrap;justify-content:center;gap:12px}
    .languages a{min-width:140px;padding:14px 18px;border:1px solid rgba(255,255,255,.25);border-radius:6px;color:#fff;text-decoration:none;font-weight:800;background:rgba(255,255,255,.06)}
    .languages a:hover{background:#0B5CAD;border-color:#0B5CAD}
    .note{margin-top:26px;font-size:12px;color:#9FB4C6}
  </style>
</head>
<body>
  <main class="wrap">
    <div class="logo">LZJPCB</div>
    <div class="eyebrow">ONE-STOP PCB / PCBA MANUFACTURING SERVICES</div>
    <h1>PCB &amp; PCBA Manufacturing From Prototype to Production</h1>
    <p class="sub">Please select your preferred language. If browser language detection is enabled, you will be redirected automatically to the closest available version.</p>

    <nav class="languages" aria-label="Language selection">
      <a href="/en/">English</a>
      <a href="/zh/">中文</a>
      <a href="/pt/">Português</a>
      <a href="/fr/">Français</a>
      <a href="/es/">Español</a>
    </nav>

    <p class="note">PCB Fabrication · PCBA Assembly · Component Sourcing</p>
  </main>

  <script>
    // 根据浏览器首选语言自动进入对应版本；不支持的语言默认进入英文。
    (function () {
      var supported = {
        'zh': '/zh/',
        'pt': '/pt/',
        'fr': '/fr/',
        'es': '/es/',
        'en': '/en/'
      };
      var languages = navigator.languages || [navigator.language || 'en'];
      var target = '/en/';
      for (var i = 0; i < languages.length; i++) {
        var lang = String(languages[i] || '').toLowerCase().split('-')[0];
        if (supported[lang]) { target = supported[lang]; break; }
      }
      // 给用户保留一个短暂的手动选择窗口，同时兼容禁用 JavaScript 的访问者。
      setTimeout(function () { window.location.href = target; }, 900);
    })();
  </script>
</body>
</html>
